{
  "name": "@repo/convex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./dist/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./dist/_generated/dataModel.d.ts",
      "default": "./convex/_generated/dataModel.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./convex/auth.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "build": "tsc --project tsconfig.build.json && mkdir -p dist/_generated && cp convex/_generated/*.d.ts dist/_generated/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/better-auth": "latest",
    "better-auth": "~1.6.15",
    "convex": "latest"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "5.9.2"
  }
}
